        { "id": "msg", "type": "button", "label": "Message", "icon": "✉", "color": "#475569", "w": 1, "h": 1, "confirm": false,
          "actions": [ { "type": "chat", "text": "{input:Message}" } ] },
        { "id": "cam", "type": "button", "label": "Watch Car", "icon": "◉", "color": "#0891b2", "w": 1, "h": 1, "confirm": false,
          "actions": [ { "type": "camera", "mode": "car", "car": "{car}", "group": "", "camera": 0 } ] }
      ]
    },
    {
      "id": "drivers",
      "name": "Drivers",
      "columns": { "narrow": 3, "wide": 6 },
      "items": [
        { "id": "dl", "type": "drivers", "w": 6, "h": 9, "sort": "position" }
      ]
    },
    {
      "id": "session",
