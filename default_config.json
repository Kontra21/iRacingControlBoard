        { "id": "eol", "type": "button", "label": "End of Line", "icon": "⤓", "color": "#7c3aed", "w": 1, "h": 1, "confirm": false,
          "actions": [ { "type": "chat", "text": "!eol #{car}" } ] },
        { "id": "dt", "type": "button", "label": "Drive-Through", "icon": "⚑", "color": "#1f2937", "w": 1, "h": 1, "confirm": false,
          "actions": [ { "type": "chat", "text": "!black #{car} D" } ] },
        { "id": "sh", "type": "button", "label": "Stop & Hold", "icon": "⏱", "color": "#1f2937", "w": 1, "h": 1, "confirm": false,
          "actions": [ { "type": "chat", "text": "!black #{car} {input:Seconds=10}" } ] },
        { "id": "clr", "type": "button", "label": "Clear Penalty", "icon": "✓", "color": "#059669", "w": 1, "h": 1, "confirm": false,
          "actions": [ { "type": "chat", "text": "!clear #{car}" } ] },
        { "id": "dq", "type": "button", "label": "Disqualify", "sub": "hold", "icon": "✕", "color": "#b91c1c", "w": 1, "h": 1, "confirm": true, "hold": true,
          "actions": [ { "type": "chat", "text": "!dq #{car}" } ] },
        { "id": "yel", "type": "button", "label": "Caution", "icon": "⚠", "color": "#eab308", "textColor": "#111111", "w": 2, "h": 1, "confirm": false,
          "actions": [ { "type": "chat", "text": "!yellow" } ] },
        { "id": "pc", "type": "button", "label": "Close Pits", "icon": "⛔", "color": "#ea580c", "w": 1, "h": 1, "confirm": false,
          "actions": [ { "type": "chat", "text": "!pitclose" } ] },
        { "id": "po", "type": "button", "label": "Open Pits", "icon": "⇥", "color": "#16a34a", "w": 1, "h": 1, "confirm": false,
          "actions": [ { "type": "chat", "text": "!pitopen" } ] },
        { "id": "clra", "type": "button", "label": "Clear All", "sub": "penalties", "icon": "✓✓", "color": "#0d9488", "w": 1, "h": 1, "confirm": false,
